# PostgreSQL bağlantısı (yerel Docker Compose varsayılan portu 5438; 5434-5437 diğer worktree'lerde kullanımda)
POSTGRES_PORT=5438
DATABASE_URL=postgres://minicrm:minicrm@localhost:5438/minicrm
TEST_DATABASE_URL=postgres://minicrm:minicrm@localhost:5438/minicrm_test

# İmzalı rol çerezi için HMAC gizli anahtarı (üretimde en az 32 rastgele bayt kullanın)
AUTH_COOKIE_SECRET=dev-only-change-me-at-least-32-bytes-long

# POST /api/demo-reset koruması için x-demo-reset-secret başlığı anahtarı (üretimde en az 16 karakter)
DEMO_RESET_SECRET=dev-only-demo-reset-secret-change-me

# Vercel Cron günlük demo sıfırlama (GET /api/cron/demo-reset, Authorization: Bearer <değer>); en az 16 karakter, yalnız Vercel'de tanımlayın
CRON_SECRET=
