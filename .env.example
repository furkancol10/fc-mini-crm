# PostgreSQL bağlantısı (yerel Docker Compose varsayılan portu 5436; 5433/5434/5435 dolu)
POSTGRES_PORT=5436
DATABASE_URL=postgres://minicrm:minicrm@localhost:5436/minicrm
TEST_DATABASE_URL=postgres://minicrm:minicrm@localhost:5436/minicrm_test

# İmzalı rol çerezi için HMAC gizli anahtarı (üretimde en az 32 rastgele bayt kullanın)
AUTH_COOKIE_SECRET=dev-only-change-me-at-least-32-bytes-long
